<mxCell id="nota_ej" value="⚑  Este es un flujo simplificado para ilustrar el sistema de diseño. Las flechas entre swimlanes se definen en el flujo real." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;fontFamily=Helvetica;fontSize=8;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="20" y="804" width="900" height="20" as="geometry"/></mxCell>
